{
  "baseline_config": "../baselines/deepspeed.json",
  "command": ["bash", "experiments/cpu/launch_deepspeed.sh", "{config}"],
  "cwd": "../../..",
  "timeout_seconds": 90,
  "environment": {"OMP_NUM_THREADS": "8", "CONFIGFUZZ_CPU_NPROC": "2"},
  "classification": {
    "invalid_patterns": ["Micro batch size per gpu: .* has to be greater than 0", "Train batch size: .* has to be greater than 0", "Gradient accumulation steps: .* has to be greater than 0", "Check batch related parameters", "Input should be greater than or equal to 0"],
    "resource_patterns": ["Cannot allocate memory", "std::bad_alloc"],
    "infrastructure_patterns": ["Address already in use", "Gloo.*connection", "Connection closed by peer"],
    "milestone_patterns": ["CONFIGFUZZ_MILESTONE:completed"],
    "unexpected_failure_after_milestone_is_bug": false
  },
  "roles": ["satisfying", "violating", "repaired"]
}
