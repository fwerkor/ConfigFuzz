{
  "baseline_config": "../baselines/deepspeed.json",
  "command": [
    "bash",
    "experiments/gpu/launch_deepspeed.sh",
    "{config}"
  ],
  "cwd": "../../..",
  "timeout_seconds": 60,
  "classification": {
    "invalid_patterns": [
      "Micro batch size per gpu: .* has to be greater than 0",
      "Train batch size: .* has to be greater than 0",
      "Gradient accumulation steps: .* has to be greater than 0",
      "Check batch related parameters",
      "Input should be greater than or equal to 0"
    ],
    "resource_patterns": [
      "CUDA out of memory",
      "OutOfMemoryError"
    ],
    "infrastructure_patterns": [
      "Address already in use",
      "NCCL.*(system error|unhandled system error|connection refused)"
    ],
    "milestone_patterns": [
      "CONFIGFUZZ_MILESTONE:completed"
    ],
    "unexpected_failure_after_milestone_is_bug": false
  },
  "roles": [
    "satisfying",
    "violating",
    "repaired"
  ]
}
