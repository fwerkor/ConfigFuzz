{
  "baseline_config": "../baselines/megatron-core.json",
  "command": [
    "bash",
    "experiments/gpu/launch_megatron_core.sh",
    "{config}"
  ],
  "cwd": "../../..",
  "timeout_seconds": 45,
  "classification": {
    "resource_patterns": [
      "CUDA out of memory",
      "OutOfMemoryError"
    ],
    "infrastructure_patterns": [
      "Address already in use",
      "NCCL.*(system error|unhandled system error|connection refused)"
    ],
    "milestone_patterns": [
      "CONFIGFUZZ_MILESTONE:completed"
    ],
    "unexpected_failure_after_milestone_is_bug": false,
    "invalid_patterns": [
      "RuntimeError: shape '.*' is invalid for input of size",
      "world_size .* is not divisible by",
      "sequence parallel not supported by torch LayerNorm",
      "When using pipeline parallelism, pipeline_dtype must be specified",
      "CONFIGFUZZ_NATIVE_VALIDATION_REJECTED",
      "Only one of self.fp16: True and self.bf16 True should be True",
      "num_moe_experts must be non-negative",
      "Cannot use sequence parallelism without tensor parallelism"
    ]
  },
  "roles": [
    "satisfying",
    "violating",
    "repaired"
  ]
}
