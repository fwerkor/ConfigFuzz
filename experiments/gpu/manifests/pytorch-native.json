{
  "baseline_config": "../baselines/pytorch-native.json",
  "command": [
    "bash",
    "experiments/gpu/launch_pytorch_native.sh",
    "{config}"
  ],
  "cwd": "../../..",
  "timeout_seconds": 45,
  "classification": {
    "invalid_patterns": [
      "Unknown backend type",
      "must be divisible by 'group_size='",
      "must not exceed the world size",
      "must be positive"
    ],
    "resource_patterns": [
      "CUDA out of memory",
      "OutOfMemoryError"
    ],
    "infrastructure_patterns": [
      "Address already in use",
      "NCCL.*(system error|unhandled system error|connection refused)"
    ],
    "milestone_patterns": [
      "CONFIGFUZZ_MILESTONE:completed"
    ],
    "unexpected_failure_after_milestone_is_bug": false
  },
  "roles": [
    "satisfying",
    "violating",
    "repaired"
  ]
}
