{
  "baseline_config": "../baselines/transformers-accelerate.json",
  "command": [
    "bash",
    "experiments/gpu/launch_transformers_accelerate.sh",
    "{config}"
  ],
  "cwd": "../../..",
  "timeout_seconds": 60,
  "classification": {
    "invalid_patterns": [
      "argument --mixed_precision: invalid choice",
      "Unknown mixed_precision mode",
      "mixed_precision.*must be one of",
      "mixed_precision.*should be one of"
    ],
    "resource_patterns": [
      "CUDA out of memory",
      "OutOfMemoryError"
    ],
    "infrastructure_patterns": [
      "Address already in use",
      "NCCL.*(system error|unhandled system error|connection refused)"
    ],
    "milestone_patterns": [
      "CONFIGFUZZ_MILESTONE:completed"
    ],
    "unexpected_failure_after_milestone_is_bug": false
  },
  "roles": [
    "satisfying",
    "violating",
    "repaired"
  ],
  "provenance_patterns": [
    "argument --mixed_precision: invalid choice"
  ]
}
