+# MSAdapter 0.7 on MindSpore 2.10 cannot register the custom bprop used by
+# MoEAuxLossAutoScaler (call_custom_bprop fails with a null top_cell_).  For
+# the PP=1 compatibility path, retain the differentiable auxiliary losses and
+# attach them to the scalar loss in the pipeline schedule.  This preserves the
+# native Megatron gradient: aux loss / num_microbatches, followed by the same
+# grad_scale_func as the main loss.
+_MSA_AUX_LOSS_BUFFER = []
+
+
+def consume_msa_aux_losses():
+    losses = list(_MSA_AUX_LOSS_BUFFER)
+    _MSA_AUX_LOSS_BUFFER.clear()
+    return losses
+
+
+if hasattr(torch, "msadapter"):
+    @classmethod
+    def _msa_moe_aux_loss_apply(cls, output: torch.Tensor, aux_loss: torch.Tensor):
+        _MSA_AUX_LOSS_BUFFER.append(aux_loss)
+        return output
+
+    MoEAuxLossAutoScaler.apply = _msa_moe_aux_loss_apply
+
